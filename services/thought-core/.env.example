# Local thought-core HTTP server
THOUGHT_CORE_HOST=127.0.0.1
THOUGHT_CORE_PORT=18787
THOUGHT_CORE_MAX_EXECUTE_ATTEMPTS=2

# Responder boundary: thought-core.turn_responder.v0
# This first adapter speaks to an OpenAI-compatible /chat/completions endpoint.
# Future adapters can replace this without changing the outer turn/event API.
THOUGHT_CORE_LLM_ENABLED=true
THOUGHT_CORE_LLM_BASE_URL=https://api.openai.com/v1
THOUGHT_CORE_LLM_API_KEY=
THOUGHT_CORE_LLM_MODEL=gpt-4o-mini
THOUGHT_CORE_LLM_TIMEOUT_S=12
THOUGHT_CORE_LLM_MAX_CHARS=220

# Optional compatibility aliases. Used only if the THOUGHT_CORE_LLM_* values
# above are blank.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
