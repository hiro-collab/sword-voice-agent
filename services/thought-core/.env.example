# Local thought-core HTTP server
THOUGHT_CORE_HOST=127.0.0.1
THOUGHT_CORE_PORT=18787
THOUGHT_CORE_MAX_EXECUTE_ATTEMPTS=2

# Credential-free primary semantic route: Sword-owned loopback broker only.
# The broker owns its existing ignored secret source. Thought Core must not carry
# an API key, credential alias, or remote provider base URL.
THOUGHT_CORE_LLM_ENABLED=true
THOUGHT_CORE_LLM_PROVIDER=sword-openai-broker
THOUGHT_CORE_LLM_BASE_URL=http://127.0.0.1:18786/v1
THOUGHT_CORE_LLM_MODEL=gpt-4o-mini
THOUGHT_CORE_LLM_TIMEOUT_S=12
THOUGHT_CORE_LLM_MAX_CHARS=220
