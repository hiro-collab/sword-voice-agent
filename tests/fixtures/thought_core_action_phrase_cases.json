      "text": "電気をつけて",
      "initial_light_on": false,
      "context_refs": {
        "mock_room_light_state": "off",
        "mock_room_light_confidence_label": "high"
      },
      "expect": {
        "action_id": "light_on",
        "target": "light",
        "expected_state": "on",
        "event_types": ["action.proposed", "tool.started", "turn.completed"],
        "speech_contains": ["リビングの電気をつけるね"],
        "speech_occurrences_max": {"リビングの電気": 2},
        "execute_calls": 1,
        "completed_status": "success"
      }
    },
    {
      "name": "light_off",
      "text": "電気を消して",
