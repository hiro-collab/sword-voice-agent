{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-agent-os.local/catalogs/actions/home-actions.schema.json",
  "title": "Home Action Driver Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "authority",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "const": "control-plane-core"
    },
    "update_flow": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "label",
        "target",
        "target_label",
        "verb",
        "aliases",
        "pre_action_phrase",
        "expected_state",
        "risk_level",
        "confirmation_required",
        "execution",
        "observation"
      ],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "target_label": { "type": "string", "minLength": 1 },
        "verb": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "pre_action_phrase": { "type": "string", "minLength": 1 },
        "expected_state": { "type": "string", "minLength": 1 },
        "expected_effect": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "confirmation_required": { "type": "boolean" },
        "confirmation_reason": {
          "type": ["string", "null"]
        },
        "execution": {
          "type": "object",
          "required": ["adapter", "ha_script"],
          "additionalProperties": false,
          "properties": {
            "adapter": { "type": "string", "const": "home-assistant" },
            "ha_script": {
              "type": "string",
              "pattern": "^script\\.[A-Za-z0-9_]+$"
            },
            "response_text": { "type": "string", "minLength": 1 }
          }
        },
        "observation": {
          "type": "object",
          "required": ["appliance_id"],
          "anyOf": [
            { "required": ["state_path"] },
            { "required": ["state_query_path"] }
          ],
          "additionalProperties": false,
          "properties": {
            "appliance_id": { "type": "string", "minLength": 1 },
            "state_path": { "type": "string", "minLength": 1 },
            "state_query_path": { "type": "string", "minLength": 1 },
            "observation_class": { "type": "string", "minLength": 1 }
          }
        },
        "intent_examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
