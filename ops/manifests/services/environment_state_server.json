{
  "service_id": "environment_state_server",
  "layer": "environment",
  "logical_service": "environment-server",
  "current_owner": "scripts/home-control-stack/start-home-control-stack.ps1",
  "repo_path": "environment-state-server",
  "pid_names": ["environment_state_server"],
  "start": {
    "type": "stack-script"
  },
  "health": {
    "type": "http",
    "url": "http://127.0.0.1:8790/environment/current"
  },
  "stop": {
    "strategy": "owned_pid"
  },
  "depends_on": ["home_assistant_bridge"]
}
