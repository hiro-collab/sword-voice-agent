{
  "service_id": "thought_core_api",
  "layer": "turn",
  "logical_service": "thought-core",
  "current_owner": "scripts/start-thought-core.ps1",
  "repo_path": "sword-control-plane",
  "service_root": "sword-control-plane/services/thought-core",
  "python_path": "sword-control-plane/services/thought-core/src",
  "contracts": [
    "turn",
    "events",
    "tools",
    "environment",
    "home-control",
    "memory",
    "access-control"
  ],
  "adapters": [
    "openai-compatible",
    "dify"
  ],
  "memory": {
    "reads": [
      "M1",
      "M2",
      "M4",
      "M5"
    ],
    "writes": [
      "M2",
      "M3"
    ],
    "candidates": [
      "M4"
    ]
  },
  "pid_names": [
    "thought_core_api"
  ],
  "start": {
    "type": "script",
    "script": "scripts/start-thought-core.ps1"
  },
  "health": {
    "type": "http",
    "url": "http://127.0.0.1:18787/health"
  },
  "stop": {
    "strategy": "owned_pid"
  },
  "depends_on": [
    "home_assistant_bridge",
    "environment_state_server"
  ]
}
