# Copy this file to .env and fill in real local values.
# Do not commit .env.

# Repository roots
# By default, use validation clones placed next to this repository:
# <cell>\sword-agent-system\
#   sword-control-plane\       # control plane repo
#   organs\voice\ai-talk-core\            # organ clone
#   organs\reflex\mediapipe-sword-sign\    # organ clone
#   organs\expression\tts-service\         # organ clone
#   organs\expression\avatar-service\      # organ clone
#   organs\diagnostics\system-house-renderer\ # organ clone
AI_TALK_CORE_ROOT=..\organs\voice\ai-talk-core
MEDIAPIPE_SWORD_SIGN_ROOT=..\organs\reflex\mediapipe-sword-sign
TTS_SERVICE_ROOT=..\organs\expression\tts-service
AVATAR_SERVICE_ROOT=..\organs\expression\avatar-service
SYSTEM_HOUSE_RENDERER_ROOT=..\organs\diagnostics\system-house-renderer

# ai_talk_core
AI_TALK_CORE_INPUT_GATE_URL=http://127.0.0.1:8000/api/input-gate
AI_TALK_CORE_WEB_TOKEN=
AI_TALK_CORE_RUNTIME_STATUS_FILE=.cache\sword_voice_agent\runtime\ai_talk_core.json

# mediapipe-sword-sign
MEDIAPIPE_SWORD_SIGN_MODEL_PATH=gesture_model.pkl
MEDIAPIPE_SWORD_SIGN_MODEL_SHA256=
MEDIAPIPE_SWORD_SIGN_ALLOW_UNTRUSTED_MODEL=0
MEDIAPIPE_SWORD_SIGN_HEARTBEAT_EVERY=1s
MEDIAPIPE_SWORD_SIGN_LATENCY_PROFILE=
MEDIAPIPE_SWORD_SIGN_STATE_EVERY=
MEDIAPIPE_SWORD_SIGN_EDGE_ONLY=0
MEDIAPIPE_SWORD_SIGN_RUNTIME_STATUS_FILE=.cache\sword_voice_agent\runtime\mediapipe_udp_publisher.json
MEDIAPIPE_SWORD_SIGN_CONTROL_HTTP_HOST=127.0.0.1
MEDIAPIPE_SWORD_SIGN_CONTROL_HTTP_PORT=18765
MEDIAPIPE_SWORD_SIGN_CONTROL_TOKEN=

# Dify Chat App API
# Used by dify watcher and diagnostics. This is the Dify app API key, not the
# HOME_CONTROL_API_TOKEN used by local Home Assistant / Environment APIs.
DIFY_BASE_URL=http://localhost:8080/v1
DIFY_API_KEY=<dify_app_api_key>
DIFY_USER=local-user
DIFY_RESPONSE_MODE=streaming
AITUBER_MESSAGE_URL=
AITUBER_HTTP_TIMEOUT_S=0.75
AITUBER_SPEECH_MAX_CHARS=80

# Thought Core turn API client
# Used by sword-console and thought-core watcher when they call the local
# thought-core service.
THOUGHT_CORE_BASE_URL=http://127.0.0.1:18787
THOUGHT_CORE_TIMEOUT_S=60
THOUGHT_CORE_USER=local-user
THOUGHT_CORE_SESSION_ID=living_room_main
THOUGHT_CORE_LOCALE=ja-JP

# Thought Core tool adapter
# Boundary: thought-core.tool_adapter.v0
# Keep this as mock for isolated development. The home-control stack sets these
# automatically when it starts Thought Core with Home Assistant bridge enabled.
THOUGHT_CORE_TOOLS_ADAPTER=mock
HOME_CONTROL_BRIDGE_URL=http://127.0.0.1:8787
HOME_ASSISTANT_BRIDGE_URL=http://127.0.0.1:8787
ENVIRONMENT_STATE_URL=http://127.0.0.1:8790/environment/current
THOUGHT_CORE_HOME_HTTP_TIMEOUT_S=3
THOUGHT_CORE_ROOM_LIGHT_WAIT_TIMEOUT_MS=1500

# Thought Core responder adapter
# Boundary: thought-core.turn_responder.v0
# These values configure only the current OpenAI-compatible HTTP adapter.
# Leave THOUGHT_CORE_LLM_API_KEY blank to use the local fallback response.
THOUGHT_CORE_LLM_ENABLED=true
THOUGHT_CORE_LLM_BASE_URL=https://api.openai.com/v1
THOUGHT_CORE_LLM_API_KEY=
THOUGHT_CORE_LLM_MODEL=gpt-4o-mini
THOUGHT_CORE_LLM_TIMEOUT_S=12
THOUGHT_CORE_LLM_MAX_CHARS=220

# Compatibility aliases. The Thought Core adapter reads these only when the
# THOUGHT_CORE_LLM_* values above are blank.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# tts-service
TTS_OUTPUT_STATUS_DIR=.cache\tts_service
TTS_SOURCE=http
TTS_HTTP_HOST=127.0.0.1
TTS_HTTP_PORT=8765
TTS_HTTP_CHUNK_MAX_CHARS=80
TTS_HTTP_CHUNK_URL=http://127.0.0.1:8765/api/tts/chunk
TTS_VOLUME_URL=http://127.0.0.1:8765/api/volume
TTS_VOLUME_PREVIEW_URL=http://127.0.0.1:8765/api/volume/preview
TTS_HTTP_TIMEOUT_S=0.75
TTS_ENGINE=windows-sapi
TTS_PLAYER=speaker
TTS_POLL_INTERVAL=1.0
TTS_VOICE_NAME=
TTS_RATE=0
TTS_VOLUME=100
TTS_APP_VOLUME=1.0
TTS_SERVICE_APP_VOLUME_FILE=.cache\tts_service\app_volume.json
TTS_OUTPUT_AUDIO_DIR=.cache\tts_service\audio_output
TTS_SERVICE_RUNTIME_STATUS_FILE=.cache\sword_voice_agent\runtime\tts_service.json
TTS_SERVICE_SHUTDOWN_TOKEN=

# avatar-service
AVATAR_SERVICE_URL=http://127.0.0.1:5173
# Leave blank to auto-select the first VRM in avatar-service/public/models.
AVATAR_MODEL_URL=
AVATAR_SERVICE_RUNTIME_STATUS_FILE=.cache\sword_voice_agent\runtime\avatar_service.json

# SystemHouseRenderer
SYSTEM_HOUSE_RENDERER_RUNTIME_STATUS_FILE=.cache\sword_voice_agent\runtime\system_house_renderer.json

# Optional auth for non-loopback bind or protected local testing.
SWORD_VOICE_AGENT_AUTH_TOKEN=

# Gesture gate tuning for the integration receiver.
SWORD_VOICE_AGENT_MIN_CONFIDENCE=0.8
SWORD_VOICE_AGENT_ACTIVATION_DELAY=0.3
SWORD_VOICE_AGENT_RELEASE_DELAY=0.5

# Set to 1 to hide transcript, command, Dify answer, IDs, and local paths in console API.
SWORD_VOICE_AGENT_REDACT_STATUS=0
