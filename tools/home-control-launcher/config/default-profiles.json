[
  {
    "id": "thought-core-v0",
    "name": "System Cell (Thought Core)",
    "group": "Primary",
    "description": "Start the current system cell with Thought Core, expression, reflex, environment, action bridge, and display services.",
    "options": {
      "StopExisting": true,
      "EnableThoughtCore": true,
      "EnableThoughtCoreWatch": true,
      "ThoughtCoreLlmProvider": "sword-openai-broker",
      "MediapipeMode": "mediamtx",
      "MediapipeNoBrowser": true
    }
  },
  {
    "id": "demo-fast",
    "name": "Compatibility visible demo",
    "group": "Compatibility",
    "description": "Start the legacy response-only display/audio path. Action intent remains deterministic, so this profile does not satisfy agentic product acceptance.",
    "options": {
      "StopExisting": false,
      "EnableThoughtCore": true,
      "EnableThoughtCoreWatch": false,
      "ThoughtCoreLlmProvider": "codex-cli",
      "ThoughtCoreNoProvider": false,
      "VoicevoxReadyTimeoutSeconds": 8,
      "SkipHomeAssistantBridge": true,
      "SkipEnvironmentState": true,
      "SkipMediapipe": true,
      "SkipVisionSnapshotProcessor": true,
      "SkipTouchDesignerGui": true,
      "MediapipeMode": "mediamtx",
      "MediapipeNoBrowser": true
    }
  },
  {
    "id": "demo-fast-action",
    "name": "Compatibility action demo",
    "group": "Compatibility",
    "description": "Start the legacy response-only path plus the Home Assistant bridge. This bounded handoff does not satisfy agentic intent or product acceptance.",
    "options": {
      "StopExisting": false,
      "EnableThoughtCore": true,
      "EnableThoughtCoreWatch": false,
      "ThoughtCoreLlmProvider": "codex-cli",
      "ThoughtCoreNoProvider": false,
      "VoicevoxReadyTimeoutSeconds": 8,
      "SkipEnvironmentState": true,
      "SkipMediapipe": true,
      "SkipVisionSnapshotProcessor": true,
      "SkipTouchDesignerGui": true,
      "MediapipeMode": "mediamtx",
      "MediapipeNoBrowser": true
    }
  },
  {
    "id": "camera-debug",
    "name": "Reflex camera debug",
    "group": "Diagnostics",
    "description": "Start MediaPipe and vision-state pieces without expression or action services.",
    "options": {
      "StopExisting": true,
      "SkipVoicevoxCheck": true,
      "SkipHomeAssistantBridge": true,
      "SkipEnvironmentState": true,
      "SkipAituber": true,
      "SkipTouchDesignerGui": true,
      "MediapipeMode": "mediamtx",
      "MediapipeOpenBrowser": true,
      "MediapipeNoBrowser": false
    }
  },
  {
    "id": "aituber-only",
    "name": "Expression runtime only",
    "group": "Diagnostics",
    "description": "Start only the expression runtime for UI and voice-output checks.",
    "options": {
      "StopExisting": true,
      "SkipVoicevoxCheck": true,
      "SkipHomeAssistantBridge": true,
      "SkipEnvironmentState": true,
      "SkipMediapipe": true,
      "SkipVisionSnapshotProcessor": true,
      "SkipTouchDesignerGui": true
    }
  },
  {
    "id": "no-touchdesigner",
    "name": "System Cell without Display runtime",
    "group": "Diagnostics",
    "description": "Start the current Thought Core stack without the display runtime GUI.",
    "options": {
      "StopExisting": true,
      "EnableThoughtCore": true,
      "EnableThoughtCoreWatch": true,
      "SkipTouchDesignerGui": true,
      "MediapipeMode": "mediamtx",
      "MediapipeNoBrowser": true
    }
  }
]
