{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-voice-agent.local/contracts/memory/retrieve-result.schema.json",
  "title": "Memory Retrieve Result",
  "type": "object",
  "required": ["schema_version", "request_id", "ok", "items"],
  "properties": {
    "schema_version": {
      "const": "memory.retrieve.result.v0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^memreq_.+"
    },
    "ok": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "memory-item.schema.json"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
