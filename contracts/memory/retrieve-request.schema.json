{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-voice-agent.local/contracts/memory/retrieve-request.schema.json",
  "title": "Memory Retrieve Request",
  "type": "object",
  "required": ["schema_version", "request_id", "requester", "scopes", "query"],
  "properties": {
    "schema_version": {
      "const": "memory.retrieve.request.v0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^memreq_.+"
    },
    "requester": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": true
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "trace_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
