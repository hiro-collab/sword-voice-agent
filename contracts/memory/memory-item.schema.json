{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-voice-agent.local/contracts/memory/memory-item.schema.json",
  "title": "Memory Item",
  "description": "Committed or candidate M4 memory item.",
  "type": "object",
  "required": [
    "schema_version",
    "memory_id",
    "memory_type",
    "scope",
    "status",
    "content",
    "source",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "memory.item.v0"
    },
    "memory_id": {
      "type": "string",
      "pattern": "^(mem|mcand)_.+"
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "semantic_fact",
        "episodic_memory",
        "user_preference",
        "failure_pattern",
        "procedural_candidate",
        "design_note"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "session",
        "semantic",
        "episodic",
        "user_preferences",
        "device_aliases",
        "failure_patterns",
        "procedural",
        "design_notes"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "committed", "rejected", "superseded"]
    },
    "content": {
      "type": "object",
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["service"],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_user_confirmation": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
