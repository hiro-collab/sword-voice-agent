{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-voice-agent.local/contracts/reflex/gesture-receiver-status.schema.json",
  "title": "Gesture Receiver Status",
  "description": "Local voice-gate status derived from a reflex gesture state.",
  "type": "object",
  "required": ["type", "timestamp", "sequence", "response"],
  "properties": {
    "type": {
      "const": "gesture_receiver_status"
    },
    "timestamp": {
      "type": "number",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "response": {
      "type": "object",
      "required": ["voice_state", "gate_decision"],
      "properties": {
        "voice_state": {
          "type": "object",
          "required": ["type", "timestamp", "phase", "mic_enabled", "recording"],
          "properties": {
            "type": {
              "const": "voice_state"
            },
            "timestamp": {
              "type": "number",
              "minimum": 0
            },
            "phase": {
              "type": "string",
              "enum": ["idle", "armed", "recording", "transcribing", "thinking", "speaking", "error"]
            },
            "mic_enabled": {
              "type": "boolean"
            },
            "recording": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "gate_decision": {
          "type": "object",
          "required": ["timestamp", "gesture_name", "raw_active", "confidence", "mic_enabled", "reason"],
          "properties": {
            "timestamp": {
              "type": "number",
              "minimum": 0
            },
            "gesture_name": {
              "type": "string",
              "minLength": 1
            },
            "raw_active": {
              "type": "boolean"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mic_enabled": {
              "type": "boolean"
            },
            "changed": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "voice_control_command": {
          "type": "object",
          "required": ["type", "timestamp", "action", "mic_enabled", "reason"],
          "properties": {
            "type": {
              "const": "voice_control_command"
            },
            "timestamp": {
              "type": "number",
              "minimum": 0
            },
            "action": {
              "type": "string",
              "enum": ["none", "start_recording", "stop_recording"]
            },
            "mic_enabled": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "turn_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "input_gate_response": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

