{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-voice-agent.local/contracts/access-control/authorization-decision.schema.json",
  "title": "Authorization Decision",
  "type": "object",
  "required": ["schema_version", "request_id", "allowed", "reason", "decided_by"],
  "properties": {
    "schema_version": {
      "const": "access.authorization.decision.v0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^authreq_.+"
    },
    "allowed": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "audit_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
