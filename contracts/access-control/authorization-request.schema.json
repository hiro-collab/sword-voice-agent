{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-voice-agent.local/contracts/access-control/authorization-request.schema.json",
  "title": "Authorization Request",
  "type": "object",
  "required": ["schema_version", "request_id", "subject", "capability", "resource"],
  "properties": {
    "schema_version": {
      "const": "access.authorization.request.v0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^authreq_.+"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
