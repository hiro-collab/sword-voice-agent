{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-voice-agent.local/contracts/turn/agentic-predecision-context.schema.json",
  "title": "Agentic Predecision Context",
  "description": "Bounded reader-safe context supplied before one agentic turn decision.",
  "type": "object",
  "required": [
    "schema_version",
    "latest_user_correction",
    "environment_state",
    "active_operations",
    "feedback_context",
    "same_session_continuity",
    "relevant_memory",
    "system_topology",
    "capability_view"
  ],
  "properties": {
    "schema_version": {
      "const": "agentic-predecision-context.v1"
    },
    "latest_user_correction": {
      "oneOf": [
        {"type": "null"},
        {
          "allOf": [
            {"$ref": "#/$defs/reader_safe_text"},
            {"minLength": 1, "maxLength": 600}
          ]
        }
      ]
    },
    "environment_state": {"$ref": "#/$defs/context_section"},
    "active_operations": {"$ref": "#/$defs/context_section"},
    "feedback_context": {"$ref": "#/$defs/context_section"},
    "relevant_memory": {"$ref": "#/$defs/context_section"},
    "same_session_continuity": {"$ref": "#/$defs/context_section"},
    "system_topology": {"$ref": "#/$defs/context_section"},
    "capability_view": {"$ref": "#/$defs/capability_view"}
  },
  "$defs": {
    "context_section": {
      "type": "object",
      "required": ["status", "status_detail", "summary", "items"],
      "properties": {
        "status": {
          "enum": ["available", "missing", "unavailable", "stale", "conflict"]
        },
        "status_detail": {
          "allOf": [
            {"$ref": "#/$defs/reader_safe_text"},
            {"maxLength": 180}
          ]
        },
        "summary": {
          "allOf": [
            {"$ref": "#/$defs/reader_safe_text"},
            {"maxLength": 360}
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/summary_item"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"not": {"const": "available"}}}
          },
          "then": {
            "properties": {"status_detail": {"minLength": 1}}
          }
        }
      ],
      "additionalProperties": false
    },
    "summary_item": {
      "type": "object",
      "maxProperties": 13,
      "propertyNames": {"$ref": "#/$defs/safe_key"},
      "additionalProperties": {"$ref": "#/$defs/bounded_value_level_1"}
    },
    "safe_key": {
      "allOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        {
          "not": {
            "anyOf": [
              {
                "enum": [
                  "api_key",
                  "args",
                  "argv",
                  "auth",
                  "authorization",
                  "command",
                  "command_line",
                  "credential",
                  "credentials",
                  "endpoint",
                  "jsonl",
                  "password",
                  "path",
                  "payload",
                  "port",
                  "provider_payload",
                  "raw",
                  "raw_config",
                  "secret",
                  "token",
                  "url",
                  "uri"
                ]
              },
              {"pattern": "^raw_"},
              {"pattern": "(_path|_url|_uri|_port)$"},
              {
                "pattern": "credential|secret|api_key|provider_payload|command_line|jsonl"
              }
            ]
          }
        }
      ]
    },
    "reader_safe_text": {
      "type": "string",
      "not": {
        "anyOf": [
          {"pattern": "://"},
          {"pattern": "[/\\\\]"},
          {"pattern": "^[Bb][Ee][Aa][Rr][Ee][Rr] "},
          {"pattern": "^[Tt][Oo][Kk][Ee][Nn] "},
          {"pattern": "^[Ss][Yy][Ss][Tt][Ee][Mm] [Pp][Rr][Oo][Mm][Pp][Tt]"},
          {"pattern": "^[Dd][Ee][Vv][Ee][Ll][Oo][Pp][Ee][Rr] [Pp][Rr][Oo][Mm][Pp][Tt]"},
          {"pattern": "[Aa][Cc][Cc][Ee][Ss][Ss]_[Tt][Oo][Kk][Ee][Nn]="},
          {"pattern": "[Aa][Pp][Ii]_[Kk][Ee][Yy]="},
          {"pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]="},
          {"pattern": "[Pp][Rr][Oo][Mm][Pp][Tt]:"}
        ]
      }
    },
    "bounded_scalar": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number", "minimum": -1000000, "maximum": 1000000},
        {
          "allOf": [
            {"$ref": "#/$defs/reader_safe_text"},
            {"minLength": 1, "maxLength": 320}
          ]
        }
      ]
    },
    "bounded_value_level_1": {
      "oneOf": [
        {"$ref": "#/$defs/bounded_scalar"},
        {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/bounded_value_level_2"}
        },
        {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": {"$ref": "#/$defs/safe_key"},
          "additionalProperties": {"$ref": "#/$defs/bounded_value_level_2"}
        }
      ]
    },
    "bounded_value_level_2": {
      "oneOf": [
        {"$ref": "#/$defs/bounded_scalar"},
        {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/bounded_value_level_3"}
        },
        {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": {"$ref": "#/$defs/safe_key"},
          "additionalProperties": {"$ref": "#/$defs/bounded_value_level_3"}
        }
      ]
    },
    "bounded_value_level_3": {"$ref": "#/$defs/bounded_scalar"},
    "capability_view": {
      "type": "object",
      "required": ["catalog", "capabilities"],
      "properties": {
        "catalog": {
          "type": "object",
          "required": ["id", "version"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 96},
            "version": {"type": "string", "minLength": 1, "maxLength": 96}
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": ["id", "description", "available"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 96},
              "description": {"type": "string", "minLength": 1, "maxLength": 180},
              "available": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
