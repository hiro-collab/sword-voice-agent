{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-voice-agent.local/contracts/turn/accepted-user-speech-candidate.schema.json",
  "title": "Accepted User Speech Candidate",
  "description": "Local ai-talk-core/input-gate handoff shape for speech that has been accepted as a user turn candidate before conversion to a normal Thought Core turn request. Shared reports must keep live/private speech redacted and publish only class/count/bucket refs.",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "accepted_text",
    "turn_id",
    "session_id",
    "acceptance_status",
    "may_start_user_turn",
    "turn_adoption_authority",
    "raw_private_publication_flags"
  ],
  "properties": {
    "schema_version": {
      "const": "accepted_user_speech_candidate.v0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "accepted_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "locale": {
      "type": "string",
      "default": "ja-JP"
    },
    "source": {
      "type": "string",
      "default": "ai_talk_core"
    },
    "acceptance_status": {
      "const": "accepted"
    },
    "may_start_user_turn": {
      "const": true
    },
    "turn_adoption_authority": {
      "const": true
    },
    "raw_private_publication_flags": {
      "const": false
    },
    "context_refs": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  },
  "additionalProperties": true
}
