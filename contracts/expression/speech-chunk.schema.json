{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-agent.local/contracts/expression/speech-chunk.schema.json",
  "title": "TTS Speech Chunk",
  "description": "Payload sent to the current TTS streaming chunk endpoint.",
  "type": "object",
  "required": ["event", "final"],
  "properties": {
    "event": {
      "type": "string",
      "minLength": 1
    },
    "delta": {
      "type": "string"
    },
    "final": {
      "type": "boolean"
    },
    "turn_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "message_id": {
      "description": "Legacy alias carrying the same canonical assistant_message_id when present.",
      "type": "string",
      "pattern": "\\S"
    },
    "assistant_message_id": {
      "type": "string",
      "pattern": "^msg_.+"
    },
    "conversation_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "elapsed_s": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
