{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-agent.local/contracts/expression/projection-performance-plan.schema.json",
  "title": "Projection PerformancePlan V1",
  "description": "Deterministic, text-free, single-effect performance plan validated by Thought Core.",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "sessionId",
    "revision",
    "action",
    "effectId",
    "position",
    "strength",
    "durationMs",
    "seed",
    "keyframes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "action": { "const": "start" },
    "effectId": { "enum": ["fire", "thunderBall"] },
    "position": { "$ref": "#/$defs/position" },
    "strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 500,
      "maximum": 12000
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/keyframe" }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "required": ["atMs", "position", "strength"],
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12000
        },
        "position": { "$ref": "#/$defs/position" },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
