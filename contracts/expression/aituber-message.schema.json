{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-agent.local/contracts/expression/aituber-message.schema.json",
  "title": "AITuberKit Direct Message",
  "description": "Body sent to AITuberKit /api/messages?clientId=<id>&type=direct_send.",
  "type": "object",
  "required": ["messages"],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "turn_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "assistant_message_id": {
      "type": "string",
      "pattern": "^msg_.+"
    },
    "message_id": {
      "description": "Legacy alias carrying the same canonical assistant_message_id value.",
      "type": "string",
      "pattern": "^msg_.+"
    },
    "response_source": {
      "const": "thought_core_assistant_message"
    }
  },
  "additionalProperties": false
}
